{
  "name": "@mosaic/agents",
  "version": "0.0.0",
  "description": "Demo: two autonomous Claude agents negotiate over XMTP and settle a private XLM/USDC trade on a Mosaic desk (Stellar testnet).",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "postinstall": "node scripts/fix-xmtp.mjs",
    "setup": "node scripts/fix-xmtp.mjs && node dist/setup.js",
    "demo": "node scripts/fix-xmtp.mjs && node dist/demo.js",
    "demo:alice": "node scripts/fix-xmtp.mjs && AGENT_NAME=alice node dist/agent.js",
    "demo:bob": "node scripts/fix-xmtp.mjs && AGENT_NAME=bob node dist/agent.js"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.199",
    "@mosaic/sdk": "workspace:*",
    "@stellar/stellar-sdk": "^16.0.1",
    "@xmtp/node-sdk": "^6.0.0",
    "viem": "^2.53.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.12.3",
    "typescript": "~6.0.2"
  }
}
